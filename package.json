{
  "name": "homebridge-atlas",
  "version": "1.0.2",
  "description": "Homebridge plugin for Atlas Home Security and RISCO Cloud alarm systems",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "engines": {
    "node": "^22.23.2 || ^24",
    "homebridge": "^2.4.0"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "atlas",
    "atlas-home-security",
    "risco",
    "risco-cloud",
    "risco-alarm",
    "alarm",
    "alarm-system",
    "home-security",
    "security-system"
  ],
  "license": "MIT",
  "author": "Dean van Niekerk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanvanniekerk/homebridge-atlas.git"
  },
  "files": [
    "dist/**/*.js",
    "!dist/diagnose.js",
    "homebridge-ui/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/ARCHITECTURE.md",
    "docs/PROJECT_STRUCTURE.md",
    "docs/CONFIGURATION.md",
    "docs/INSTALLATION.md",
    "docs/VALIDATION.md",
    "docs/RELEASING.md",
    "scripts/check-release.mjs",
    "scripts/release-notes.mjs",
    "RELEASE_STEPS.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check:runtime": "npm run typecheck && npm run build && npm test",
    "check": "biome check . && npm run check:runtime",
    "diagnose": "npm run build && node dist/diagnose.js",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.1",
    "homebridge": "2.4.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "homepage": "https://github.com/deanvanniekerk/homebridge-atlas#readme",
  "bugs": {
    "url": "https://github.com/deanvanniekerk/homebridge-atlas/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6",
    "zod": "4.6.5"
  }
}
