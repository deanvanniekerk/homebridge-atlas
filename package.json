{
  "name": "homebridge-atlas",
  "version": "1.0.1",
  "description": "Homebridge plugin for Atlas Home Security and RISCO Cloud alarm systems",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "engines": {
    "node": "^22.23.2 || ^24",
    "homebridge": "^2.4.0"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "atlas",
    "atlas-home-security",
    "risco",
    "risco-cloud",
    "risco-alarm",
    "alarm",
    "alarm-system",
    "home-security",
    "security-system"
  ],
  "license": "MIT",
  "author": "Dean van Niekerk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanvanniekerk/homebridge-atlas.git"
  },
  "files": [
    "dist/*.js",
    "!dist/diagnose.js",
    "homebridge-ui/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/ARCHITECTURE.md",
    "docs/CONFIGURATION.md",
    "docs/INSTALLATION.md",
    "docs/images/",
    "docs/VALIDATION.md",
    "docs/RELEASING.md",
    "scripts/check-release.mjs",
    "scripts/release-notes.mjs",
    "RELEASE_STEPS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "diagnose": "npm run build && node dist/diagnose.js",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "homebridge": "2.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "homepage": "https://github.com/deanvanniekerk/homebridge-atlas#readme",
  "bugs": {
    "url": "https://github.com/deanvanniekerk/homebridge-atlas/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6"
  }
}
